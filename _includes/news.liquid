<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        class="news-scroll" style="max-height: 60vw"
      {% endif %}
    >
      <ol class="news-timeline">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <li class="news-item">
            <time class="news-date" datetime="{{ item.date | date: '%Y-%m-%d' }}">
              {%- if page.lang == 'zh' %}{{ item.date | date: '%Y 年 %-m 月' }}{% else %}{{ item.date | date: '%b %Y' }}{% endif -%}
            </time>
            <div class="news-body">
              {% if item.inline %}
                {% if page.lang == 'zh' and item.zh %}
                  {{ item.zh | markdownify | remove: '<p>' | remove: '</p>' | emojify }}
                {% else %}
                  {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                {% endif %}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ol>
    </div>
  {% else %}
    {% if page.lang == 'zh' %}
      <p>暂无学术动态。</p>
    {% else %}
      <p>No news so far...</p>
    {% endif %}
  {% endif %}
</div>
